OPENROUTER_API_KEY=

# Modelos de OpenRouter separados por comas: si el primero está saturado, se usa el siguiente.
# Los que acaban en :free son gratuitos (con límite de peticiones diarias).
# De pago y más fiable para la demo: anthropic/claude-opus-5.5
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
